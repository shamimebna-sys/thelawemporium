# ==============================================================================
# The Law Emporium — Environment Configuration Template
# Copy this file to .env and configure all variables before running the app.
# NEVER commit .env to version control.
# ==============================================================================

# PostgreSQL database connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/thelowemporium?schema=public"

# Secret key used to sign and verify admin session JWTs
# REQUIRED in production. Must be a strong, unpredictable random string.
# Generate with: openssl rand -base64 48
JWT_SECRET="generate-a-strong-random-secret-at-least-32-chars-long"

# Public site URL (used in canonical links, OpenGraph metadata, and sitemaps)
# Example: https://thelawemporium.com
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Initial password for the first admin user created by `prisma db seed`
# REQUIRED when running initial database seed. Must be at least 8 characters.
# The seed script will NOT overwrite existing admin passwords on rerun.
SEED_ADMIN_PASSWORD="change-this-to-a-strong-initial-password-before-seeding"